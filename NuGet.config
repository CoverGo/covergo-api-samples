<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    <clear /> is deliberate. This repository is public and must restore from nuget.org
    alone: it must not inherit a private feed from a parent directory, and it must
    behave identically for a customer who clones it standalone.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
