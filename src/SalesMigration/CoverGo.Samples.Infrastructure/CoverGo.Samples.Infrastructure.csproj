<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adapters: configuration, authentication, and (added by the gateway-client story)
    the generated Strawberry Shake clients. This is the only layer allowed to know
    that CoverGo speaks GraphQL.
  -->

  <ItemGroup>
    <ProjectReference Include="..\CoverGo.Samples.Application\CoverGo.Samples.Application.csproj" />
    <ProjectReference Include="..\CoverGo.Samples.Infrastructure.GatewayV1Client\CoverGo.Samples.Infrastructure.GatewayV1Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
